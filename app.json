{
  "expo": {
    "name": "DAILYMEAL",
    "slug": "dailymeal",
    "scheme": "dailymeal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dorentinash.dailymeal"
    },
    "android": {
      "package": "com.dorentinash.dailymeal",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "DAILYMEAL uses your photos so a meal can show what it looks like.",
          "cameraPermission": "DAILYMEAL uses the camera so you can photograph a meal you have just cooked."
        }
      ]
    ]
  }
}
